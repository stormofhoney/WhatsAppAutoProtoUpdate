{
  "name": "baileys-proto-updater",
  "version": "0.9.9-rc001",
  "description": "Runtime plugin for @whiskeysockets/baileys (7.x): pulls the latest WhatsApp proto straight from web.whatsapp.com, patches WAProto + the handshake version on disk and hot-swaps them at runtime – with an event callback.",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "baileys-proto-updater": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "workers",
    "types",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/e2e.mjs"
  },
  "keywords": [
    "baileys",
    "whatsapp",
    "protobuf",
    "proto",
    "updater",
    "wa-web"
  ],
  "author": "stormofhoney",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stormofhoney/WhatsAppAutoProtoUpdate.git"
  },
  "homepage": "https://github.com/stormofhoney/WhatsAppAutoProtoUpdate",
  "bugs": {
    "url": "https://github.com/stormofhoney/WhatsAppAutoProtoUpdate/issues"
  },
  "dependencies": {
    "@stormofhoney/oak": "file:vendor/stormofhoney-oak-0.9.9-rc001.tgz",
    "protobufjs": "^7.6.6",
    "protobufjs-cli": "^1.1.3"
  },
  "peerDependencies": {
    "@whiskeysockets/baileys": ">=7.0.0-rc14 <8.0.0-0"
  },
  "peerDependenciesMeta": {
    "@whiskeysockets/baileys": {
      "optional": true
    }
  }
}
